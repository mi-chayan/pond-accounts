/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The app files must never be served stale, otherwise a change you publish
# would sit behind Cloudflare's cache and the investors would not see it.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/app.js
  Cache-Control: no-cache, no-store, must-revalidate
/styles.css
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# Icons never change, so let them cache hard.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
